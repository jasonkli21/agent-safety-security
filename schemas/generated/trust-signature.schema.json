{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "Ed25519",
      "title": "Algorithm",
      "type": "string"
    },
    "candidate_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "key_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
      "title": "Key Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "signature_hex": {
      "pattern": "^[0-9a-f]{128}$",
      "title": "Signature Hex",
      "type": "string"
    },
    "subject_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Subject Digest",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "subject_digest",
    "key_id",
    "algorithm",
    "issued_at",
    "expires_at",
    "signature_hex"
  ],
  "title": "Signature",
  "type": "object"
}
