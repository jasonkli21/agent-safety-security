{
  "$defs": {
    "Change": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "ADDED",
            "REMOVED",
            "CHANGED",
            "INCOMPLETE"
          ],
          "title": "Status",
          "type": "string"
        },
        "target": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "target",
        "status"
      ],
      "title": "Change",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changes": {
      "items": {
        "$ref": "#/$defs/Change"
      },
      "title": "Changes",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "changes"
  ],
  "title": "InventoryDiff",
  "type": "object"
}
