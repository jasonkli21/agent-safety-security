{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Safe commitment only; cannot prove graph authority without protected session state.",
  "properties": {
    "authority_path_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authority Path Digest",
      "type": "string"
    },
    "generation": {
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "graph_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Graph Digest",
      "type": "string"
    },
    "node_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
      "title": "Node Id",
      "type": "string"
    },
    "path": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Path",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "graph_digest",
    "generation",
    "node_id",
    "path",
    "authority_path_digest"
  ],
  "title": "GraphBinding",
  "type": "object"
}
