{
  "$defs": {
    "DataLabel": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "SENSITIVE",
        "SECRET",
        "PII",
        "CREDENTIAL",
        "UNTRUSTED_CONTENT",
        "USER_PROVIDED",
        "TOOL_OUTPUT"
      ],
      "title": "DataLabel",
      "type": "string"
    },
    "ExecutionBinding": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_kind": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Adapter Kind",
          "type": "string"
        },
        "adapter_version": {
          "default": "1",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Adapter Version",
          "type": "string"
        },
        "binding_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Binding Digest",
          "type": "string"
        },
        "isolation_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isolation Digest"
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "adapter_kind",
        "adapter_id",
        "binding_digest"
      ],
      "title": "ExecutionBinding",
      "type": "object"
    },
    "JsonValue": {},
    "SecurityCategory": {
      "enum": [
        "PROMPT_INJECTION",
        "GOAL_HIJACKING",
        "UNAUTHORIZED_TOOL_USE",
        "EXCESSIVE_AGENCY",
        "ARGUMENT_VIOLATION",
        "APPROVAL_BYPASS",
        "SECRET_EXFILTRATION",
        "PII_EXPOSURE",
        "MEMORY_POISONING",
        "TOOL_POISONING",
        "SUPPLY_CHAIN_CHANGE",
        "RESOURCE_EXHAUSTION",
        "DELEGATION_ESCALATION",
        "POLICY_BYPASS",
        "TRACE_INTEGRITY_FAILURE"
      ],
      "title": "SecurityCategory",
      "type": "string"
    },
    "SideEffectClass": {
      "enum": [
        "NONE",
        "READ",
        "INTERNAL_WRITE",
        "EXTERNAL_WRITE",
        "DESTRUCTIVE",
        "CODE_EXECUTION",
        "IDENTITY_PRIVILEGE",
        "FINANCIAL",
        "INFRASTRUCTURE"
      ],
      "title": "SideEffectClass",
      "type": "string"
    },
    "ToolDescriptor": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "side_effect_class": {
                "const": "DESTRUCTIVE"
              }
            },
            "required": [
              "side_effect_class"
            ]
          },
          "then": {
            "properties": {
              "destructive": {
                "const": true
              }
            },
            "required": [
              "destructive"
            ]
          }
        }
      ],
      "properties": {
        "capabilities": {
          "items": {
            "maxLength": 128,
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "data_access_labels": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DataLabel"
          },
          "title": "Data Access Labels",
          "type": "array",
          "uniqueItems": true
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "destructive": {
          "default": false,
          "title": "Destructive",
          "type": "boolean"
        },
        "idempotent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotent"
        },
        "input_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Input Schema",
          "type": "object"
        },
        "name": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Namespace",
          "type": "string"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema"
        },
        "protocol": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Protocol",
          "type": "string"
        },
        "risk_tags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SecurityCategory"
          },
          "title": "Risk Tags",
          "type": "array",
          "uniqueItems": true
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "server_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server Id"
        },
        "side_effect_class": {
          "$ref": "#/$defs/SideEffectClass"
        },
        "tool_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Tool Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "schema_version",
        "tool_id",
        "namespace",
        "name",
        "protocol",
        "description",
        "input_schema",
        "side_effect_class",
        "capabilities"
      ],
      "title": "ToolDescriptor",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_display_paths": {
      "default": [],
      "items": {
        "items": {
          "maxLength": 8192,
          "minLength": 1,
          "type": "string"
        },
        "type": "array"
      },
      "title": "Approval Display Paths",
      "type": "array"
    },
    "data_sink_destination": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data Sink Destination"
    },
    "descriptor": {
      "$ref": "#/$defs/ToolDescriptor"
    },
    "execution_binding": {
      "$ref": "#/$defs/ExecutionBinding"
    },
    "output_data_labels": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/DataLabel"
          },
          "type": "array",
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Data Labels"
    },
    "resource_argument_path": {
      "anyOf": [
        {
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Argument Path"
    },
    "resource_semantics": {
      "anyOf": [
        {
          "const": "opaque_exact",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Semantics"
    },
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "descriptor",
    "execution_binding"
  ],
  "title": "ProtectedTool",
  "type": "object"
}
