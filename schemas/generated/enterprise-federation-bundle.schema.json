{
  "$defs": {
    "FederationPayload": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "default": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "compiled_plan_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Compiled Plan Digest",
          "type": "string"
        },
        "compiler_version": {
          "const": "phase6-v1",
          "default": "phase6-v1",
          "title": "Compiler Version",
          "type": "string"
        },
        "document_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Document Hash",
          "type": "string"
        },
        "effective_policy_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Effective Policy Hash",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "key_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "title": "Key Id",
          "type": "string"
        },
        "local_policy_key": {
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "title": "Local Policy Key",
          "type": "string"
        },
        "origin": {
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "title": "Origin",
          "type": "string"
        },
        "policy_key": {
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "title": "Policy Key",
          "type": "string"
        },
        "purpose": {
          "const": "federation",
          "default": "federation",
          "title": "Purpose",
          "type": "string"
        },
        "revision_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "title": "Revision Id",
          "type": "string"
        },
        "schema_version": {
          "const": "enterprise-v1",
          "default": "enterprise-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "maximum": 1000000000,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "source": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "target",
        "policy_key",
        "local_policy_key",
        "revision_id",
        "key_id",
        "sequence",
        "issued_at",
        "expires_at",
        "document_hash",
        "effective_policy_hash",
        "compiled_plan_digest",
        "source"
      ],
      "title": "FederationPayload",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "payload": {
      "$ref": "#/$defs/FederationPayload"
    },
    "schema_version": {
      "const": "enterprise-v1",
      "default": "enterprise-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "signature": {
      "pattern": "^[0-9a-f]{128}$",
      "title": "Signature",
      "type": "string"
    }
  },
  "required": [
    "payload",
    "signature"
  ],
  "title": "FederatedPolicyBundle",
  "type": "object"
}
