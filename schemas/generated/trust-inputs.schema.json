{
  "$defs": {
    "ArtifactInput": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "path": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "candidate_id",
        "path"
      ],
      "title": "ArtifactInput",
      "type": "object"
    },
    "Dependency": {
      "additionalProperties": false,
      "properties": {
        "artifact_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Digest"
        },
        "conflicting_declarations": {
          "default": false,
          "title": "Conflicting Declarations",
          "type": "boolean"
        },
        "declaration_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Declaration Digest",
          "type": "string"
        },
        "extras": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Extras",
          "type": "array"
        },
        "marker_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marker Digest"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Name",
          "type": "string"
        },
        "provenance": {
          "default": "declared",
          "enum": [
            "declared",
            "resolved",
            "artifact_hashed"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Digest"
        },
        "source_kind": {
          "default": "registry",
          "enum": [
            "registry",
            "direct_url",
            "unsupported"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "specifier": {
          "default": "",
          "title": "Specifier",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "name",
        "declaration_digest"
      ],
      "title": "Dependency",
      "type": "object"
    },
    "DependencyManifest": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "default": "DECLARED_ONLY",
          "enum": [
            "DECLARED_ONLY",
            "INCOMPLETE"
          ],
          "title": "Completeness",
          "type": "string"
        },
        "dependencies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "maxItems": 2048,
          "title": "Dependencies",
          "type": "array"
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "enum": [
            "local_pyproject",
            "operator_declaration"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "source"
      ],
      "title": "DependencyManifest",
      "type": "object"
    },
    "Signature": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "key_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Key Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "signature_hex": {
          "pattern": "^[0-9a-f]{128}$",
          "title": "Signature Hex",
          "type": "string"
        },
        "subject_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Subject Digest",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "candidate_id",
        "subject_digest",
        "key_id",
        "algorithm",
        "issued_at",
        "expires_at",
        "signature_hex"
      ],
      "title": "Signature",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactInput"
      },
      "maxItems": 2048,
      "title": "Artifacts",
      "type": "array"
    },
    "dependencies": {
      "anyOf": [
        {
          "$ref": "#/$defs/DependencyManifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "signatures": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Signature"
      },
      "maxItems": 2048,
      "title": "Signatures",
      "type": "array"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "TrustInputs",
  "type": "object"
}
