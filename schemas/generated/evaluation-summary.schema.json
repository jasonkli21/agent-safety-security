{
  "$defs": {
    "AssertionResult": {
      "additionalProperties": false,
      "properties": {
        "assertion_index": {
          "minimum": 0,
          "title": "Assertion Index",
          "type": "integer"
        },
        "assertion_type": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Assertion Type",
          "type": "string"
        },
        "evidence_artifact_refs": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
            "type": "string"
          },
          "title": "Evidence Artifact Refs",
          "type": "array"
        },
        "evidence_event_refs": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
            "type": "string"
          },
          "title": "Evidence Event Refs",
          "type": "array"
        },
        "matched_observation_refs": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
            "type": "string"
          },
          "title": "Matched Observation Refs",
          "type": "array"
        },
        "message": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EvaluationStatus"
        }
      },
      "required": [
        "assertion_index",
        "assertion_type",
        "status",
        "message"
      ],
      "title": "AssertionResult",
      "type": "object"
    },
    "EvaluationCounts": {
      "additionalProperties": false,
      "properties": {
        "errors": {
          "minimum": 0,
          "title": "Errors",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "inconclusive": {
          "minimum": 0,
          "title": "Inconclusive",
          "type": "integer"
        },
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        }
      },
      "required": [
        "passed",
        "failed",
        "inconclusive",
        "errors"
      ],
      "title": "EvaluationCounts",
      "type": "object"
    },
    "EvaluationMetrics": {
      "additionalProperties": false,
      "properties": {
        "approval_decisions": {
          "default": 0,
          "minimum": 0,
          "title": "Approval Decisions",
          "type": "integer"
        },
        "approval_requests": {
          "default": 0,
          "minimum": 0,
          "title": "Approval Requests",
          "type": "integer"
        },
        "findings": {
          "default": 0,
          "minimum": 0,
          "title": "Findings",
          "type": "integer"
        },
        "security_assertions_failed": {
          "default": 0,
          "minimum": 0,
          "title": "Security Assertions Failed",
          "type": "integer"
        },
        "security_assertions_inconclusive": {
          "default": 0,
          "minimum": 0,
          "title": "Security Assertions Inconclusive",
          "type": "integer"
        },
        "security_assertions_passed": {
          "default": 0,
          "minimum": 0,
          "title": "Security Assertions Passed",
          "type": "integer"
        },
        "security_signals": {
          "default": 0,
          "minimum": 0,
          "title": "Security Signals",
          "type": "integer"
        },
        "tool_dispatches": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Dispatches",
          "type": "integer"
        },
        "tool_requests": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Requests",
          "type": "integer"
        },
        "tool_returns": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Returns",
          "type": "integer"
        },
        "utility_assertions_failed": {
          "default": 0,
          "minimum": 0,
          "title": "Utility Assertions Failed",
          "type": "integer"
        },
        "utility_assertions_inconclusive": {
          "default": 0,
          "minimum": 0,
          "title": "Utility Assertions Inconclusive",
          "type": "integer"
        },
        "utility_assertions_passed": {
          "default": 0,
          "minimum": 0,
          "title": "Utility Assertions Passed",
          "type": "integer"
        }
      },
      "title": "EvaluationMetrics",
      "type": "object"
    },
    "EvaluationResult": {
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Contract Id",
          "type": "string"
        },
        "effective_policy_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Effective Policy Hash",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "metrics": {
          "$ref": "#/$defs/EvaluationMetrics",
          "default": {
            "approval_decisions": 0,
            "approval_requests": 0,
            "findings": 0,
            "security_assertions_failed": 0,
            "security_assertions_inconclusive": 0,
            "security_assertions_passed": 0,
            "security_signals": 0,
            "tool_dispatches": 0,
            "tool_requests": 0,
            "tool_returns": 0,
            "utility_assertions_failed": 0,
            "utility_assertions_inconclusive": 0,
            "utility_assertions_passed": 0
          }
        },
        "overall_status": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "scenario_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "security_assertions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AssertionResult"
          },
          "title": "Security Assertions",
          "type": "array"
        },
        "security_status": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "trace_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Trace Id",
          "type": "string"
        },
        "utility_assertions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AssertionResult"
          },
          "title": "Utility Assertions",
          "type": "array"
        },
        "utility_status": {
          "$ref": "#/$defs/EvaluationStatus"
        }
      },
      "required": [
        "schema_version",
        "scenario_id",
        "contract_id",
        "effective_policy_hash",
        "run_id",
        "trace_id",
        "security_status",
        "utility_status",
        "overall_status"
      ],
      "title": "EvaluationResult",
      "type": "object"
    },
    "EvaluationStatus": {
      "enum": [
        "PASS",
        "INCONCLUSIVE",
        "FAIL",
        "ERROR"
      ],
      "title": "EvaluationStatus",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "artifact_refs": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
            "type": "string"
          },
          "title": "Artifact Refs",
          "type": "array",
          "uniqueItems": true
        },
        "category": {
          "$ref": "#/$defs/SecurityCategory"
        },
        "description": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "event_refs": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
            "type": "string"
          },
          "title": "Event Refs",
          "type": "array",
          "uniqueItems": true
        },
        "expected": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "finding_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Finding Id",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "remediation_hint": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remediation Hint"
        },
        "run_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "scenario_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Id"
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "title": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "finding_id",
        "category",
        "severity",
        "title",
        "description"
      ],
      "title": "Finding",
      "type": "object"
    },
    "SecurityCategory": {
      "enum": [
        "PROMPT_INJECTION",
        "GOAL_HIJACKING",
        "UNAUTHORIZED_TOOL_USE",
        "EXCESSIVE_AGENCY",
        "ARGUMENT_VIOLATION",
        "APPROVAL_BYPASS",
        "SECRET_EXFILTRATION",
        "PII_EXPOSURE",
        "MEMORY_POISONING",
        "TOOL_POISONING",
        "SUPPLY_CHAIN_CHANGE",
        "RESOURCE_EXHAUSTION",
        "DELEGATION_ESCALATION",
        "POLICY_BYPASS",
        "TRACE_INTEGRITY_FAILURE"
      ],
      "title": "SecurityCategory",
      "type": "string"
    },
    "Severity": {
      "description": "Ordered numeric wire values; never a probabilistic score.",
      "enum": [
        0,
        1,
        2,
        3,
        4
      ],
      "title": "Severity",
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
      "title": "Contract Id",
      "type": "string"
    },
    "counts": {
      "$ref": "#/$defs/EvaluationCounts"
    },
    "effective_policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Effective Policy Hash",
      "type": "string"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/EvaluationResult"
      },
      "title": "Results",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "evaluated_at",
    "contract_id",
    "effective_policy_hash",
    "results",
    "counts"
  ],
  "title": "EvaluationSummary",
  "type": "object"
}
