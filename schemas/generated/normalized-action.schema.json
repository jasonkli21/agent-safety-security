{
  "$defs": {
    "DataArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "labels": {
          "items": {
            "$ref": "#/$defs/DataLabel"
          },
          "title": "Labels",
          "type": "array",
          "uniqueItems": true
        },
        "origin": {
          "$ref": "#/$defs/DataOrigin"
        },
        "parent_artifact_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array",
          "uniqueItems": true
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "labels",
        "origin"
      ],
      "title": "DataArtifactRef",
      "type": "object"
    },
    "DataLabel": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "SENSITIVE",
        "SECRET",
        "PII",
        "CREDENTIAL",
        "UNTRUSTED_CONTENT",
        "USER_PROVIDED",
        "TOOL_OUTPUT"
      ],
      "title": "DataLabel",
      "type": "string"
    },
    "DataOrigin": {
      "additionalProperties": false,
      "properties": {
        "origin_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Origin Type",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "trust_class": {
          "$ref": "#/$defs/TrustClass"
        }
      },
      "required": [
        "origin_type",
        "trust_class"
      ],
      "title": "DataOrigin",
      "type": "object"
    },
    "JsonValue": {},
    "PrincipalRef": {
      "additionalProperties": false,
      "properties": {
        "principal_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Principal Id",
          "type": "string"
        },
        "principal_type": {
          "$ref": "#/$defs/PrincipalType"
        }
      },
      "required": [
        "principal_id",
        "principal_type"
      ],
      "title": "PrincipalRef",
      "type": "object"
    },
    "PrincipalType": {
      "enum": [
        "USER",
        "AGENT",
        "SERVICE"
      ],
      "title": "PrincipalType",
      "type": "string"
    },
    "TrustClass": {
      "enum": [
        "TRUSTED_CONFIG",
        "USER_INPUT",
        "UNTRUSTED_EXTERNAL",
        "TOOL_OUTPUT",
        "MODEL_OUTPUT",
        "GENERATED_POLICY_SUGGESTION"
      ],
      "title": "TrustClass",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Use complete arguments, never a lossy/redacted PolicyRequest summary.",
  "properties": {
    "agent_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
      "title": "Agent Id",
      "type": "string"
    },
    "arguments": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Arguments",
      "type": "object"
    },
    "authority_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authority Digest"
    },
    "capability": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "title": "Capability",
      "type": "string"
    },
    "data_artifact_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DataArtifactRef"
      },
      "title": "Data Artifact Refs",
      "type": "array"
    },
    "data_destination": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data Destination"
    },
    "delegation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delegation Id"
    },
    "effective_policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Effective Policy Hash",
      "type": "string"
    },
    "environment": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
      "title": "Environment",
      "type": "string"
    },
    "execution_binding_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Binding Digest"
    },
    "principal": {
      "$ref": "#/$defs/PrincipalRef"
    },
    "resource": {
      "anyOf": [
        {
          "maxLength": 8192,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource"
    },
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "tool_description_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Tool Description Hash",
      "type": "string"
    },
    "tool_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
      "title": "Tool Id",
      "type": "string"
    },
    "tool_schema_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Tool Schema Hash",
      "type": "string"
    },
    "trust_snapshot_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trust Snapshot Digest"
    }
  },
  "required": [
    "schema_version",
    "principal",
    "agent_id",
    "environment",
    "capability",
    "tool_id",
    "arguments",
    "tool_schema_hash",
    "tool_description_hash",
    "effective_policy_hash"
  ],
  "title": "NormalizedAction",
  "type": "object"
}
