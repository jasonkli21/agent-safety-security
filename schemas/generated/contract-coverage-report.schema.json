{
  "$defs": {
    "AtomCoverage": {
      "additionalProperties": false,
      "properties": {
        "adapter_boundary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Boundary"
        },
        "adapter_required": {
          "default": false,
          "title": "Adapter Required",
          "type": "boolean"
        },
        "adapter_status": {
          "enum": [
            "NOT_REQUIRED",
            "UNPROVEN",
            "COVERED",
            "UNCOVERED"
          ],
          "title": "Adapter Status",
          "type": "string"
        },
        "atom_id": {
          "title": "Atom Id",
          "type": "string"
        },
        "compiled": {
          "title": "Compiled",
          "type": "boolean"
        },
        "eval_case_ids": {
          "items": {
            "type": "string"
          },
          "title": "Eval Case Ids",
          "type": "array"
        },
        "eval_status": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR",
            "NOT_RUN"
          ],
          "title": "Eval Status",
          "type": "string"
        },
        "intent_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Intent Digest",
          "type": "string"
        },
        "probe_ids": {
          "items": {
            "type": "string"
          },
          "title": "Probe Ids",
          "type": "array"
        },
        "probe_status": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR",
            "NOT_RUN"
          ],
          "title": "Probe Status",
          "type": "string"
        },
        "provenance_input_required": {
          "default": false,
          "title": "Provenance Input Required",
          "type": "boolean"
        },
        "runtime_supported": {
          "title": "Runtime Supported",
          "type": "boolean"
        },
        "sink_classification_required": {
          "default": false,
          "title": "Sink Classification Required",
          "type": "boolean"
        },
        "sink_classification_status": {
          "default": "NOT_REQUIRED",
          "enum": [
            "NOT_REQUIRED",
            "UNPROVEN",
            "COVERED",
            "UNCOVERED"
          ],
          "title": "Sink Classification Status",
          "type": "string"
        },
        "sink_runtime_status": {
          "default": "NOT_REQUIRED",
          "enum": [
            "NOT_REQUIRED",
            "UNPROVEN",
            "REACHABLE",
            "UNREACHABLE"
          ],
          "title": "Sink Runtime Status",
          "type": "string"
        },
        "source_classification_required": {
          "default": false,
          "title": "Source Classification Required",
          "type": "boolean"
        },
        "source_classification_status": {
          "default": "NOT_REQUIRED",
          "enum": [
            "NOT_REQUIRED",
            "UNPROVEN",
            "COVERED",
            "UNCOVERED"
          ],
          "title": "Source Classification Status",
          "type": "string"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        },
        "source_runtime_status": {
          "default": "NOT_REQUIRED",
          "enum": [
            "NOT_REQUIRED",
            "UNPROVEN",
            "REACHABLE",
            "UNREACHABLE"
          ],
          "title": "Source Runtime Status",
          "type": "string"
        }
      },
      "required": [
        "atom_id",
        "source_ref",
        "compiled",
        "runtime_supported",
        "intent_digest",
        "adapter_status",
        "probe_ids",
        "eval_case_ids",
        "probe_status",
        "eval_status"
      ],
      "title": "AtomCoverage",
      "type": "object"
    },
    "PlanIdentity": {
      "additionalProperties": false,
      "properties": {
        "compiled_plan_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Compiled Plan Digest",
          "type": "string"
        },
        "compiler_version": {
          "title": "Compiler Version",
          "type": "string"
        },
        "contract_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Contract Id",
          "type": "string"
        },
        "effective_policy_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Effective Policy Hash",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "compiler_version",
        "effective_policy_hash",
        "compiled_plan_digest"
      ],
      "title": "PlanIdentity",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "atoms": {
      "items": {
        "$ref": "#/$defs/AtomCoverage"
      },
      "title": "Atoms",
      "type": "array"
    },
    "effective_policy_hash": {
      "title": "Effective Policy Hash",
      "type": "string"
    },
    "plan_identity": {
      "$ref": "#/$defs/PlanIdentity"
    },
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "effective_policy_hash",
    "plan_identity",
    "atoms"
  ],
  "title": "CoverageReport",
  "type": "object"
}
