{
  "$defs": {
    "ApprovalOutcome": {
      "enum": [
        "APPROVE",
        "DENY"
      ],
      "title": "ApprovalOutcome",
      "type": "string"
    },
    "DataArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "labels": {
          "items": {
            "$ref": "#/$defs/DataLabel"
          },
          "title": "Labels",
          "type": "array",
          "uniqueItems": true
        },
        "origin": {
          "$ref": "#/$defs/DataOrigin"
        },
        "parent_artifact_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array",
          "uniqueItems": true
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "labels",
        "origin"
      ],
      "title": "DataArtifactRef",
      "type": "object"
    },
    "DataLabel": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "SENSITIVE",
        "SECRET",
        "PII",
        "CREDENTIAL",
        "UNTRUSTED_CONTENT",
        "USER_PROVIDED",
        "TOOL_OUTPUT"
      ],
      "title": "DataLabel",
      "type": "string"
    },
    "DataOrigin": {
      "additionalProperties": false,
      "properties": {
        "origin_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Origin Type",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "trust_class": {
          "$ref": "#/$defs/TrustClass"
        }
      },
      "required": [
        "origin_type",
        "trust_class"
      ],
      "title": "DataOrigin",
      "type": "object"
    },
    "FinishStep": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "FINISH",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "FinishStep",
      "type": "object"
    },
    "JsonValue": {},
    "OutputStep": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "OUTPUT",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "OutputStep",
      "type": "object"
    },
    "PolicyOutcome": {
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_APPROVAL",
        "ERROR"
      ],
      "title": "PolicyOutcome",
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "EXPLICIT_ALLOW",
        "EXPLICIT_DENY",
        "DEFAULT_DENY",
        "APPROVAL_REQUIRED",
        "UNKNOWN_CAPABILITY",
        "OUTSIDE_TASK_SCOPE",
        "BUDGET_EXCEEDED",
        "DATA_FLOW_DENIED",
        "DATA_FLOW_CONTEXT_MISSING",
        "INVALID_REQUEST",
        "POLICY_ENGINE_ERROR"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "SecurityCategory": {
      "enum": [
        "PROMPT_INJECTION",
        "GOAL_HIJACKING",
        "UNAUTHORIZED_TOOL_USE",
        "EXCESSIVE_AGENCY",
        "ARGUMENT_VIOLATION",
        "APPROVAL_BYPASS",
        "SECRET_EXFILTRATION",
        "PII_EXPOSURE",
        "MEMORY_POISONING",
        "TOOL_POISONING",
        "SUPPLY_CHAIN_CHANGE",
        "RESOURCE_EXHAUSTION",
        "DELEGATION_ESCALATION",
        "POLICY_BYPASS",
        "TRACE_INTEGRITY_FAILURE"
      ],
      "title": "SecurityCategory",
      "type": "string"
    },
    "Severity": {
      "description": "Ordered numeric wire values; never a probabilistic score.",
      "enum": [
        0,
        1,
        2,
        3,
        4
      ],
      "title": "Severity",
      "type": "integer"
    },
    "SignalStep": {
      "additionalProperties": false,
      "properties": {
        "artifact_refs": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
            "type": "string"
          },
          "title": "Artifact Refs",
          "type": "array",
          "uniqueItems": true
        },
        "category": {
          "$ref": "#/$defs/SecurityCategory"
        },
        "redacted_summary": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redacted Summary"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "type": {
          "const": "SECURITY_SIGNAL",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "category",
        "severity"
      ],
      "title": "SignalStep",
      "type": "object"
    },
    "TerminateStep": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "$ref": "#/$defs/ReasonCode"
        },
        "type": {
          "const": "TERMINATE",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "title": "TerminateStep",
      "type": "object"
    },
    "ToolCallStep": {
      "additionalProperties": false,
      "properties": {
        "approval_outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "capability": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Capability",
          "type": "string"
        },
        "data_artifact_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DataArtifactRef"
          },
          "title": "Data Artifact Refs",
          "type": "array"
        },
        "data_destination": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Destination"
        },
        "external_sink_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Sink Text"
        },
        "matched_rule_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
            "type": "string"
          },
          "title": "Matched Rule Ids",
          "type": "array",
          "uniqueItems": true
        },
        "policy_outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/PolicyOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason_codes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reason Codes",
          "type": "array",
          "uniqueItems": true
        },
        "resource": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource"
        },
        "response_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DataArtifactRef"
          },
          "title": "Response Artifacts",
          "type": "array"
        },
        "tool_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Tool Id",
          "type": "string"
        },
        "type": {
          "const": "TOOL_CALL",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "tool_id",
        "capability",
        "arguments"
      ],
      "title": "ToolCallStep",
      "type": "object"
    },
    "TrustClass": {
      "enum": [
        "TRUSTED_CONFIG",
        "USER_INPUT",
        "UNTRUSTED_EXTERNAL",
        "TOOL_OUTPUT",
        "MODEL_OUTPUT",
        "GENERATED_POLICY_SUGGESTION"
      ],
      "title": "TrustClass",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "fixture_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
      "title": "Fixture Id",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "steps": {
      "items": {
        "discriminator": {
          "mapping": {
            "FINISH": "#/$defs/FinishStep",
            "OUTPUT": "#/$defs/OutputStep",
            "SECURITY_SIGNAL": "#/$defs/SignalStep",
            "TERMINATE": "#/$defs/TerminateStep",
            "TOOL_CALL": "#/$defs/ToolCallStep"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ToolCallStep"
          },
          {
            "$ref": "#/$defs/SignalStep"
          },
          {
            "$ref": "#/$defs/OutputStep"
          },
          {
            "$ref": "#/$defs/TerminateStep"
          },
          {
            "$ref": "#/$defs/FinishStep"
          }
        ]
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "fixture_id",
    "scenario_id",
    "steps"
  ],
  "title": "TargetFixture",
  "type": "object"
}
