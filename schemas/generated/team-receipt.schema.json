{
  "$defs": {
    "Counters": {
      "additionalProperties": false,
      "properties": {
        "approval_decided": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Approval Decided",
          "type": "integer"
        },
        "approval_requested": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Approval Requested",
          "type": "integer"
        },
        "denied": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Denied",
          "type": "integer"
        },
        "dispatched": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Dispatched",
          "type": "integer"
        },
        "effect_verified": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Effect Verified",
          "type": "integer"
        },
        "errors": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Errors",
          "type": "integer"
        },
        "requested": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Requested",
          "type": "integer"
        },
        "returned": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Returned",
          "type": "integer"
        },
        "schema_version": {
          "const": "team-v1",
          "default": "team-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "Counters",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "title": "Agent Id",
          "type": "string"
        },
        "ci": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "PASS",
            "FAIL",
            "ERROR",
            "INCONCLUSIVE"
          ],
          "title": "Ci",
          "type": "string"
        },
        "completeness": {
          "default": "INCOMPLETE",
          "enum": [
            "INCOMPLETE",
            "REPORTED_COMPLETE"
          ],
          "title": "Completeness",
          "type": "string"
        },
        "counters": {
          "$ref": "#/$defs/Counters",
          "default": {
            "approval_decided": 0,
            "approval_requested": 0,
            "denied": 0,
            "dispatched": 0,
            "effect_verified": 0,
            "errors": 0,
            "requested": 0,
            "returned": 0,
            "schema_version": "team-v1"
          }
        },
        "coverage": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "GAPS",
            "SYNTHETIC_PASS"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "environment": {
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "title": "Environment",
          "type": "string"
        },
        "mode": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "ENFORCE",
            "SHADOW",
            "DISABLED"
          ],
          "title": "Mode",
          "type": "string"
        },
        "period_end": {
          "format": "date-time",
          "title": "Period End",
          "type": "string"
        },
        "period_start": {
          "format": "date-time",
          "title": "Period Start",
          "type": "string"
        },
        "policy_revision": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,47}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Revision"
        },
        "regression": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "PASS",
            "FAIL",
            "ERROR",
            "DRAFT"
          ],
          "title": "Regression",
          "type": "string"
        },
        "replay": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "PASS",
            "FAIL",
            "BLOCKED"
          ],
          "title": "Replay",
          "type": "string"
        },
        "repository": {
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "title": "Repository",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "team-v1",
          "default": "team-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "enum": [
            "RUNTIME",
            "CI"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "agent_id",
        "environment",
        "repository",
        "source",
        "period_start",
        "period_end"
      ],
      "title": "Metadata",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assurance": {
      "const": "REPORTED_UNVERIFIED",
      "default": "REPORTED_UNVERIFIED",
      "title": "Assurance",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,47}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "report": {
      "$ref": "#/$defs/Metadata"
    },
    "schema_version": {
      "const": "team-v1",
      "default": "team-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "received_at",
    "report"
  ],
  "title": "Receipt",
  "type": "object"
}
