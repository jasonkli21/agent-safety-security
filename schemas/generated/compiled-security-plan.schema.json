{
  "$defs": {
    "AgentBinding": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Agent Id",
          "type": "string"
        },
        "environment": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Environment",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrincipalRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "trust_level": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trust Level"
        }
      },
      "required": [
        "agent_id",
        "environment"
      ],
      "title": "AgentBinding",
      "type": "object"
    },
    "ApprovalSettings": {
      "additionalProperties": false,
      "properties": {
        "default_timeout_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "title": "Default Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "ApprovalSettings",
      "type": "object"
    },
    "CompiledScope": {
      "additionalProperties": false,
      "properties": {
        "requested_capabilities": {
          "anyOf": [
            {
              "items": {
                "maxLength": 128,
                "minLength": 3,
                "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ],
          "title": "Requested Capabilities"
        },
        "resources": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ResourceCeiling"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resources"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "requested_capabilities",
        "resources"
      ],
      "title": "CompiledScope",
      "type": "object"
    },
    "PrincipalRef": {
      "additionalProperties": false,
      "properties": {
        "principal_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Principal Id",
          "type": "string"
        },
        "principal_type": {
          "$ref": "#/$defs/PrincipalType"
        }
      },
      "required": [
        "principal_id",
        "principal_type"
      ],
      "title": "PrincipalRef",
      "type": "object"
    },
    "PrincipalType": {
      "enum": [
        "USER",
        "AGENT",
        "SERVICE"
      ],
      "title": "PrincipalType",
      "type": "string"
    },
    "ResourceCeiling": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Capability",
          "type": "string"
        },
        "resources": {
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "title": "Resources",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "capability",
        "resources"
      ],
      "title": "ResourceCeiling",
      "type": "object"
    },
    "RuleDecision": {
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_APPROVAL"
      ],
      "title": "RuleDecision",
      "type": "string"
    },
    "RuntimeBudgets": {
      "additionalProperties": false,
      "properties": {
        "max_destructive_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Destructive Calls"
        },
        "max_external_writes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max External Writes"
        },
        "max_runtime_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Runtime Seconds"
        },
        "max_tool_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tool Calls"
        }
      },
      "title": "RuntimeBudgets",
      "type": "object"
    },
    "SemanticAtom": {
      "additionalProperties": false,
      "properties": {
        "adapter_required": {
          "default": false,
          "title": "Adapter Required",
          "type": "boolean"
        },
        "atom_id": {
          "title": "Atom Id",
          "type": "string"
        },
        "compiled": {
          "title": "Compiled",
          "type": "boolean"
        },
        "intent_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Intent Digest",
          "type": "string"
        },
        "runtime_supported": {
          "title": "Runtime Supported",
          "type": "boolean"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        }
      },
      "required": [
        "atom_id",
        "source_ref",
        "compiled",
        "runtime_supported",
        "intent_digest"
      ],
      "title": "SemanticAtom",
      "type": "object"
    },
    "ToolRule": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Capability",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/RuleDecision"
        },
        "resource": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource"
        },
        "rule_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "capability",
        "decision"
      ],
      "title": "ToolRule",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent": {
      "$ref": "#/$defs/AgentBinding"
    },
    "approvals": {
      "$ref": "#/$defs/ApprovalSettings"
    },
    "atoms": {
      "items": {
        "$ref": "#/$defs/SemanticAtom"
      },
      "title": "Atoms",
      "type": "array"
    },
    "budgets": {
      "$ref": "#/$defs/RuntimeBudgets"
    },
    "compiler_version": {
      "const": "phase3-v2",
      "default": "phase3-v2",
      "title": "Compiler Version",
      "type": "string"
    },
    "contract_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
      "title": "Contract Id",
      "type": "string"
    },
    "contract_schema_version": {
      "const": "0.1",
      "title": "Contract Schema Version",
      "type": "string"
    },
    "effective_policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Effective Policy Hash",
      "type": "string"
    },
    "environment": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
      "title": "Environment",
      "type": "string"
    },
    "principal": {
      "$ref": "#/$defs/PrincipalRef"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/ToolRule"
      },
      "title": "Rules",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompiledScope"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "contract_id",
    "contract_schema_version",
    "effective_policy_hash",
    "agent",
    "principal",
    "environment",
    "rules",
    "scope",
    "budgets",
    "approvals",
    "atoms"
  ],
  "title": "CompiledSecurityPlan",
  "type": "object"
}
