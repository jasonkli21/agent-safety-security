{
  "$defs": {
    "AgentIdentity": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Agent Id",
          "type": "string"
        },
        "environment": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Environment",
          "type": "string"
        },
        "framework": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Framework"
        },
        "model_name": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "model_provider": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Provider"
        },
        "name": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrincipalRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "trust_level": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trust Level"
        }
      },
      "required": [
        "agent_id",
        "name",
        "environment"
      ],
      "title": "AgentIdentity",
      "type": "object"
    },
    "ApprovalDecidedPayload": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/ApprovalDecision"
        },
        "kind": {
          "const": "APPROVAL_DECIDED",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "decision"
      ],
      "title": "ApprovalDecidedPayload",
      "type": "object"
    },
    "ApprovalDecision": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Approval Id",
          "type": "string"
        },
        "approver": {
          "$ref": "#/$defs/PrincipalRef"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ApprovalOutcome"
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ApprovalScope",
          "default": "ONE_SHOT"
        }
      },
      "required": [
        "schema_version",
        "approval_id",
        "approver",
        "outcome",
        "decided_at"
      ],
      "title": "ApprovalDecision",
      "type": "object"
    },
    "ApprovalOutcome": {
      "enum": [
        "APPROVE",
        "DENY"
      ],
      "title": "ApprovalOutcome",
      "type": "string"
    },
    "ApprovalRequest": {
      "additionalProperties": false,
      "properties": {
        "action_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Action Digest",
          "type": "string"
        },
        "approval_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Approval Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "policy_request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Policy Request Id",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reason Codes",
          "type": "array",
          "uniqueItems": true
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "approval_id",
        "policy_request_id",
        "action_digest",
        "summary",
        "reason_codes",
        "created_at"
      ],
      "title": "ApprovalRequest",
      "type": "object"
    },
    "ApprovalRequestedPayload": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "$ref": "#/$defs/ApprovalRequest"
        },
        "kind": {
          "const": "APPROVAL_REQUESTED",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "approval"
      ],
      "title": "ApprovalRequestedPayload",
      "type": "object"
    },
    "ApprovalScope": {
      "enum": [
        "ONE_SHOT"
      ],
      "title": "ApprovalScope",
      "type": "string"
    },
    "DataArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "labels": {
          "items": {
            "$ref": "#/$defs/DataLabel"
          },
          "title": "Labels",
          "type": "array",
          "uniqueItems": true
        },
        "origin": {
          "$ref": "#/$defs/DataOrigin"
        },
        "parent_artifact_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array",
          "uniqueItems": true
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "labels",
        "origin"
      ],
      "title": "DataArtifactRef",
      "type": "object"
    },
    "DataLabel": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "SENSITIVE",
        "SECRET",
        "PII",
        "CREDENTIAL",
        "UNTRUSTED_CONTENT",
        "USER_PROVIDED",
        "TOOL_OUTPUT"
      ],
      "title": "DataLabel",
      "type": "string"
    },
    "DataOrigin": {
      "additionalProperties": false,
      "properties": {
        "origin_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Origin Type",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "trust_class": {
          "$ref": "#/$defs/TrustClass"
        }
      },
      "required": [
        "origin_type",
        "trust_class"
      ],
      "title": "DataOrigin",
      "type": "object"
    },
    "EffectVerifiedPayload": {
      "additionalProperties": false,
      "properties": {
        "dispatch_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Dispatch Id",
          "type": "string"
        },
        "evidence_artifact_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Artifact Refs",
          "type": "array",
          "uniqueItems": true
        },
        "kind": {
          "const": "EFFECT_VERIFIED",
          "title": "Kind",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        },
        "verifier": {
          "$ref": "#/$defs/PrincipalRef"
        }
      },
      "required": [
        "kind",
        "dispatch_id",
        "request_id",
        "verifier",
        "verified",
        "evidence_artifact_refs"
      ],
      "title": "EffectVerifiedPayload",
      "type": "object"
    },
    "EnforcementMode": {
      "enum": [
        "ENFORCE",
        "SHADOW",
        "DISABLED"
      ],
      "title": "EnforcementMode",
      "type": "string"
    },
    "EventType": {
      "enum": [
        "RUN_STARTED",
        "RUN_FINISHED",
        "TOOL_REQUESTED",
        "POLICY_EVALUATED",
        "APPROVAL_REQUESTED",
        "APPROVAL_DECIDED",
        "TOOL_DISPATCHED",
        "TOOL_RETURNED",
        "SECURITY_SIGNAL",
        "RUN_TERMINATED",
        "EFFECT_VERIFIED"
      ],
      "title": "EventType",
      "type": "string"
    },
    "JsonValue": {},
    "PolicyDecision": {
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Contract Id",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decision_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Decision Id",
          "type": "string"
        },
        "effective_policy_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Effective Policy Hash",
          "type": "string"
        },
        "human_reason": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Reason"
        },
        "matched_rule_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
            "type": "string"
          },
          "title": "Matched Rule Ids",
          "type": "array",
          "uniqueItems": true
        },
        "outcome": {
          "$ref": "#/$defs/PolicyOutcome"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array",
          "uniqueItems": true
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "decision_id",
        "request_id",
        "outcome",
        "reason_codes",
        "contract_id",
        "effective_policy_hash",
        "decided_at"
      ],
      "title": "PolicyDecision",
      "type": "object"
    },
    "PolicyEvaluatedPayload": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "kind": {
          "const": "POLICY_EVALUATED",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "decision"
      ],
      "title": "PolicyEvaluatedPayload",
      "type": "object"
    },
    "PolicyOutcome": {
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_APPROVAL",
        "ERROR"
      ],
      "title": "PolicyOutcome",
      "type": "string"
    },
    "PolicyRequest": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentIdentity"
        },
        "arguments_summary": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arguments Summary"
        },
        "capability": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Capability",
          "type": "string"
        },
        "data_artifact_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DataArtifactRef"
          },
          "title": "Data Artifact Refs",
          "type": "array"
        },
        "delegation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delegation Id"
        },
        "environment": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Environment",
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/PrincipalRef"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "resource": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource"
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "task_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tool_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Id"
        },
        "trajectory_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trajectory Ref"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "principal",
        "agent",
        "capability",
        "environment",
        "requested_at"
      ],
      "title": "PolicyRequest",
      "type": "object"
    },
    "PrincipalRef": {
      "additionalProperties": false,
      "properties": {
        "principal_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Principal Id",
          "type": "string"
        },
        "principal_type": {
          "$ref": "#/$defs/PrincipalType"
        }
      },
      "required": [
        "principal_id",
        "principal_type"
      ],
      "title": "PrincipalRef",
      "type": "object"
    },
    "PrincipalType": {
      "enum": [
        "USER",
        "AGENT",
        "SERVICE"
      ],
      "title": "PrincipalType",
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "EXPLICIT_ALLOW",
        "EXPLICIT_DENY",
        "DEFAULT_DENY",
        "APPROVAL_REQUIRED",
        "UNKNOWN_CAPABILITY",
        "OUTSIDE_TASK_SCOPE",
        "BUDGET_EXCEEDED",
        "DATA_FLOW_DENIED",
        "INVALID_REQUEST",
        "POLICY_ENGINE_ERROR"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "RunFinishedPayload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "RUN_FINISHED",
          "title": "Kind",
          "type": "string"
        },
        "output_artifact_refs": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
            "type": "string"
          },
          "title": "Output Artifact Refs",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "kind"
      ],
      "title": "RunFinishedPayload",
      "type": "object"
    },
    "RunStartedPayload": {
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Contract Id",
          "type": "string"
        },
        "effective_policy_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Effective Policy Hash",
          "type": "string"
        },
        "kind": {
          "const": "RUN_STARTED",
          "title": "Kind",
          "type": "string"
        },
        "scenario_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Id"
        }
      },
      "required": [
        "kind",
        "contract_id",
        "effective_policy_hash"
      ],
      "title": "RunStartedPayload",
      "type": "object"
    },
    "RunTerminatedPayload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "RUN_TERMINATED",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/ReasonCode"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "title": "RunTerminatedPayload",
      "type": "object"
    },
    "SecurityCategory": {
      "enum": [
        "PROMPT_INJECTION",
        "GOAL_HIJACKING",
        "UNAUTHORIZED_TOOL_USE",
        "EXCESSIVE_AGENCY",
        "ARGUMENT_VIOLATION",
        "APPROVAL_BYPASS",
        "SECRET_EXFILTRATION",
        "PII_EXPOSURE",
        "MEMORY_POISONING",
        "TOOL_POISONING",
        "SUPPLY_CHAIN_CHANGE",
        "RESOURCE_EXHAUSTION",
        "DELEGATION_ESCALATION",
        "POLICY_BYPASS",
        "TRACE_INTEGRITY_FAILURE"
      ],
      "title": "SecurityCategory",
      "type": "string"
    },
    "SecuritySignalPayload": {
      "additionalProperties": false,
      "properties": {
        "artifact_refs": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
            "type": "string"
          },
          "title": "Artifact Refs",
          "type": "array",
          "uniqueItems": true
        },
        "category": {
          "$ref": "#/$defs/SecurityCategory"
        },
        "kind": {
          "const": "SECURITY_SIGNAL",
          "title": "Kind",
          "type": "string"
        },
        "redacted_summary": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redacted Summary"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "kind",
        "category",
        "severity"
      ],
      "title": "SecuritySignalPayload",
      "type": "object"
