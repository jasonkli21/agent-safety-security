{
  "$defs": {
    "RiskFinding": {
      "additionalProperties": false,
      "properties": {
        "evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "field_path": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Field Path",
          "type": "string"
        },
        "rationale": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Rationale",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
          "title": "Rule Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ],
          "title": "Severity",
          "type": "string"
        },
        "target": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "rule_id",
        "severity",
        "target",
        "field_path",
        "rationale",
        "evidence_digest"
      ],
      "title": "RiskFinding",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/RiskFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "findings"
  ],
  "title": "ScanReport",
  "type": "object"
}
