{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_generation": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Base Generation",
      "type": "integer"
    },
    "compiler_version": {
      "const": "phase6-v1",
      "default": "phase6-v1",
      "title": "Compiler Version",
      "type": "string"
    },
    "policy_key": {
      "pattern": "^[a-z][a-z0-9_-]{0,47}$",
      "title": "Policy Key",
      "type": "string"
    },
    "revision_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,47}$",
      "title": "Revision Id",
      "type": "string"
    },
    "schema_version": {
      "const": "team-v1",
      "default": "team-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "maxLength": 65536,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "upload_source": {
      "const": true,
      "title": "Upload Source",
      "type": "boolean"
    }
  },
  "required": [
    "revision_id",
    "policy_key",
    "source",
    "upload_source",
    "base_generation"
  ],
  "title": "RevisionInput",
  "type": "object"
}
