{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "reason": {
      "enum": [
        "COMPENSATING_CONTROL",
        "TIME_BOUND_REMEDIATION",
        "BUSINESS_CONTINUITY"
      ],
      "title": "Reason",
      "type": "string"
    },
    "risk_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,47}$",
      "title": "Risk Id",
      "type": "string"
    },
    "schema_version": {
      "const": "enterprise-v1",
      "default": "enterprise-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "target_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,47}$",
      "title": "Target Id",
      "type": "string"
    },
    "target_kind": {
      "enum": [
        "case",
        "revision"
      ],
      "title": "Target Kind",
      "type": "string"
    },
    "target_version": {
      "maximum": 1000000,
      "minimum": 1,
      "title": "Target Version",
      "type": "integer"
    }
  },
  "required": [
    "risk_id",
    "target_kind",
    "target_id",
    "target_version",
    "reason",
    "expires_at"
  ],
  "title": "RiskInput",
  "type": "object"
}
