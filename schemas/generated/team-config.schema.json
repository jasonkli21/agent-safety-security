{
  "$defs": {
    "Issuer": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Audience",
          "type": "string"
        },
        "issuer": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Issuer",
          "type": "string"
        },
        "keys": {
          "items": {
            "$ref": "#/$defs/Key"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Keys",
          "type": "array"
        },
        "schema_version": {
          "const": "team-v1",
          "default": "team-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "audience",
        "keys"
      ],
      "title": "Issuer",
      "type": "object"
    },
    "Key": {
      "additionalProperties": false,
      "properties": {
        "kid": {
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "title": "Kid",
          "type": "string"
        },
        "public_key_pem": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Public Key Pem",
          "type": "string"
        },
        "schema_version": {
          "const": "team-v1",
          "default": "team-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kid",
        "public_key_pem"
      ],
      "title": "Key",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "issuers": {
      "items": {
        "$ref": "#/$defs/Issuer"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Issuers",
      "type": "array"
    },
    "retention_seconds": {
      "default": 2592000,
      "maximum": 31536000,
      "minimum": 60,
      "title": "Retention Seconds",
      "type": "integer"
    },
    "schema_version": {
      "const": "team-v1",
      "default": "team-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "skew_seconds": {
      "default": 0,
      "maximum": 60,
      "minimum": 0,
      "title": "Skew Seconds",
      "type": "integer"
    },
    "stale_seconds": {
      "default": 3600,
      "maximum": 604800,
      "minimum": 60,
      "title": "Stale Seconds",
      "type": "integer"
    }
  },
  "required": [
    "issuers"
  ],
  "title": "TeamConfig",
  "type": "object"
}
