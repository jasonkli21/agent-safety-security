{
  "$defs": {
    "PolicyOutcome": {
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_APPROVAL",
        "ERROR"
      ],
      "title": "PolicyOutcome",
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "EXPLICIT_ALLOW",
        "EXPLICIT_DENY",
        "DEFAULT_DENY",
        "APPROVAL_REQUIRED",
        "UNKNOWN_CAPABILITY",
        "OUTSIDE_TASK_SCOPE",
        "BUDGET_EXCEEDED",
        "DATA_FLOW_DENIED",
        "DATA_FLOW_CONTEXT_MISSING",
        "INVALID_REQUEST",
        "POLICY_ENGINE_ERROR"
      ],
      "title": "ReasonCode",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
      "title": "Contract Id",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
      "title": "Decision Id",
      "type": "string"
    },
    "effective_policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Effective Policy Hash",
      "type": "string"
    },
    "human_reason": {
      "anyOf": [
        {
          "maxLength": 8192,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Human Reason"
    },
    "matched_rule_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
        "type": "string"
      },
      "title": "Matched Rule Ids",
      "type": "array",
      "uniqueItems": true
    },
    "outcome": {
      "$ref": "#/$defs/PolicyOutcome"
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/ReasonCode"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array",
      "uniqueItems": true
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "request_id",
    "outcome",
    "reason_codes",
    "contract_id",
    "effective_policy_hash",
    "decided_at"
  ],
  "title": "PolicyDecision",
  "type": "object"
}
